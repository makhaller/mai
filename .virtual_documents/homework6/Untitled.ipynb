import numpy as np

arr = np.array([
    [2, 3, 5],
    [14, 6, 8], 
    [11, 13, 17], 
    [7, 10, 13]
]) 

def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def rows_with_prime_number(arr):
    result = []

    for row in arr:
        for value in row:
            if is_prime(value):
                result.append(row)
                break 
    return np.array(result)

print(rows_with_prime_number(arr))


import numpy as np 

def checkerboard():
    board = np.zeros((8, 8), dtype=int)

    board[0::2, ::2] = 1
    board[1::2, 1::2] = 1

    return board

print(checkerboard())

def reverse_checkerboard():
    board = np.zeros((8, 8), dtype=int)

    board[0::2, 1::2] = 1
    board[1::2, ::2] = 1

    return board 

print(reverse_checkerboard())


import numpy as np 

def expansion(arr, n):
    spaces = " " * n
    expanded = []

    for word in arr:
        expanded_word = spaces.join(list(word))
        expanded.append(expanded_word)

    return np.array(expanded)

alien_language = np.array(['@*%$%&', '*@^*(#)#'])
print(expansion(alien_language, 1))
print(expansion(alien_language, 3))


import numpy as np

np.random.seed(246)
stars = np.randint(200, 10000, (5,5))

def secondDimmest(arr):
    sorted_rows = np.sort(arr, axis=1)
    return sorted_rows[:, -2]

print(secondDimmest(stars))



